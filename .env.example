# Primeiro administrador (usado só quando ainda não há usuários)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
# Servidor com pouca memória (ex.: Render starter): 1 = abre uma aba por vez
LOW_MEMORY=
# Porta do servidor
PORT=3000
# Chave gratuita do Google PageSpeed Insights (opcional, recomendado):
# https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=
# Caminho do Chrome/Chromium, se não for encontrado automaticamente
CHROME_PATH=
# Quantas análises rodam ao mesmo tempo
MAX_CONCURRENT_JOBS=2
# Pasta onde os relatórios são salvos (banco SQLite + imagens)
DATA_DIR=./data
